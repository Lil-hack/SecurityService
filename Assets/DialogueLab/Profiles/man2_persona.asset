  m_Name: man2_persona
  m_EditorClassIdentifier: Assembly-CSharp::OfficeStaffPersona
  id: man2
  displayName: "\u0411\u043E\u0440\u0438\u0441"
  difficulty: 3
  personality: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439, \u043F\u0440\u0438\u0434\u0438\u0440\u0447\u0438\u0432\u044B\u0439 \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440 \u0438 \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044C \u043F\u043E\u0440\u044F\u0434\u043A\u0430. \u0423\u043C\u0435\u0435\u0442 \u043D\u0430\u0439\u0442\u0438 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u044E\u0449\u0443\u044E \u043A\u043E\u043F\u0435\u0439\u043A\u0443 \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C. \u0428\u0443\u0442\u0438\u0442 \u0441\u0443\u0445\u043E, \u043A\u0430\u043A \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u043F\u0435\u0447\u0430\u0442\u044C, \u043D\u043E \u0432\u0442\u0430\u0439\u043D\u0435 \u043B\u044E\u0431\u0438\u0442 \u0437\u0430\u0441\u043B\u0443\u0436\u0435\u043D\u043D\u0443\u044E \u043F\u043E\u0445\u0432\u0430\u043B\u0443."
  preferences: "\u0423\u0432\u0430\u0436\u0430\u0435\u0442 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0443\u044E \u043F\u043E\u0445\u0432\u0430\u043B\u0443 \u0435\u0433\u043E \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438, \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u0438, \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044E \u0438 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438\u043B\u0438 \u0434\u0435\u043D\u0435\u0433 \u043A\u043E\u043C\u0430\u043D\u0434\u044B. \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u044B \u043E \u0437\u0430\u0439\u043C\u0435 \u2014 \u044F\u0441\u043D\u0430\u044F \u0446\u0435\u043B\u044C, \u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u044B\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430 \u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u0441\u0440\u043E\u043A. \u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u043B\u0438\u043C\u0435\u043D\u0442 \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C, \u043D\u043E \u043E\u0431\u0449\u0430\u044F \u043B\u0435\u0441\u0442\u044C, \u0436\u0430\u043B\u043E\u0441\u0442\u044C \u0438 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442. \u0422\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F \u0440\u0430\u0437\u043D\u044B\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0438 \u0434\u043E\u0432\u043E\u0434\u044B, \u0430 \u043D\u0435 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0438 \u043E\u0434\u043D\u043E\u0439 \u043F\u043E\u0445\u0432\u0430\u043B\u044B."
  greeting: "\u0411\u043E\u0440\u0438\u0441 \u041A\u043E\u043F\u0435\u0439\u043A\u0438\u043D. \u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u0448\u0451\u043B \u0437\u0430 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438, \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043C \u0442\u0432\u043E\u044E \u043F\u0440\u043E\u0441\u044C\u0431\u0443 \u0441\u043E \u0437\u0434\u0440\u0430\u0432\u044B\u043C \u0441\u043C\u044B\u0441\u043B\u043E\u043C."
  alreadyPaidGreeting: "\u041F\u044F\u0442\u044C\u0441\u043E\u0442 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432 \u0443\u0436\u0435 \u0432\u044B\u0434\u0430\u043D\u044B. \u042F \u0437\u0430\u043F\u0438\u0441\u0430\u043B, \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B, \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u0437\u0430 \u0442\u043E\u0431\u043E\u0439."
