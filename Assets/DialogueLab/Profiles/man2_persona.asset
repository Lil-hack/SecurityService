  preparedVoicePath: Models/Piper/Mantella-RU-Piper-1.0/SKSE/Plugins/MantellaSoftware/piper/models/skyrim/low/maleeventoned.onnx
  preparedGreeting: "\u0411\u043E\u0440\u0438\u0441 \u041A\u043E\u043F\u0435\u0439\u043A\u0438\u043D. \u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u0448\u0451\u043B \u0437\u0430 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438, \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043C \u0442\u0432\u043E\u044E \u043F\u0440\u043E\u0441\u044C\u0431\u0443 \u0441\u043E \u0437\u0434\u0440\u0430\u0432\u044B\u043C \u0441\u043C\u044B\u0441\u043B\u043E\u043C."
  preparedPaid: "\u041F\u044F\u0442\u044C\u0441\u043E\u0442 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432 \u0443\u0436\u0435 \u0432\u044B\u0434\u0430\u043D\u044B. \u042F \u0437\u0430\u043F\u0438\u0441\u0430\u043B, \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B, \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u0437\u0430 \u0442\u043E\u0431\u043E\u0439."
