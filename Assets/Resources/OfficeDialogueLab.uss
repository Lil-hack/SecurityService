.lab { flex-grow: 1; padding: 22px; background-color: rgb(14, 22, 33); color: rgb(230, 237, 246); font-size: 22px; }
.lab-title { font-size: 34px; -unity-font-style: bold; margin-bottom: 4px; }
.columns { flex-direction: row; flex-grow: 1; min-height: 0; margin-top: 18px; }
.roster { width: 235px; flex-shrink: 0; margin-right: 16px; }
.conversation { flex-grow: 1; flex-basis: 0; min-width: 350px; padding: 16px; background-color: rgb(22, 34, 49); border-radius: 16px; }
.inspector { width: 440px; flex-shrink: 0; margin-left: 16px; padding: 16px; background-color: rgb(25, 38, 54); border-radius: 16px; }
.section-title, #settings-title { font-size: 27px; -unity-font-style: bold; margin-bottom: 10px; }
.row { flex-direction: row; align-items: center; margin-top: 5px; margin-bottom: 8px; }
Button { min-height: 44px; font-size: 20px; color: rgb(234, 242, 250); background-color: rgb(43, 62, 82); border-radius: 8px; border-width: 0; padding: 8px; margin: 3px; white-space: normal; }
Button:hover { background-color: rgb(57, 84, 107); }
Button:disabled { opacity: .42; }
.row > Button { flex-grow: 1; flex-basis: 0; font-size: 18px; }
.person { flex-direction: row; align-items: center; min-height: 112px; margin: 0 0 10px 0; padding: 10px; }
.person > Image { width: 54px; height: 64px; flex-shrink: 0; margin-right: 10px; border-radius: 10px; }
.person-labels { flex-grow: 1; flex-basis: 0; min-width: 0; }
.person-labels > Label { white-space: normal; font-size: 18px; margin-bottom: 5px; }
.selected { background-color: rgb(25, 106, 101); }
.chat { flex-grow: 1; flex-basis: 0; min-height: 80px; margin-top: 8px; margin-bottom: 8px; background-color: rgb(14, 24, 36); border-radius: 10px; padding: 8px; }
.bubble { white-space: normal; font-size: 23px; margin: 6px 12px 12px 0; padding: 14px; background-color: rgb(37, 55, 75); border-radius: 10px; }
.player-bubble { margin-left: 24px; margin-right: 0; background-color: rgb(27, 81, 87); }
.metrics { white-space: normal; font-size: 19px; color: rgb(121, 217, 199); min-height: 48px; }
.status { white-space: normal; font-size: 19px; margin-top: 6px; min-height: 46px; }
.hint { white-space: normal; font-size: 17px; color: rgb(161, 184, 206); margin-top: 8px; margin-bottom: 6px; }
.primary { background-color: rgb(24, 125, 109); min-height: 50px; }
.message-input { min-height: 95px; max-height: 140px; font-size: 23px; }
.settings-scroll { flex-grow: 1; flex-basis: 0; min-height: 0; }
.settings-scroll Label { white-space: normal; }
TextField { margin-top: 9px; margin-bottom: 9px; flex-direction: column; }
TextField > Label { width: auto; font-size: 20px; margin-bottom: 6px; }
TextField > .unity-text-field__input { min-height: 40px; background-color: rgb(13, 24, 36); color: rgb(232, 241, 250); padding: 9px; border-radius: 6px; white-space: normal; }
.long-field > .unity-text-field__input { min-height: 130px; }
Slider, SliderInt { margin-top: 14px; margin-bottom: 14px; flex-direction: column; }
Slider > Label, SliderInt > Label { min-width: 200px; margin-bottom: 8px; }
Toggle { font-size: 18px; margin: 8px; }
