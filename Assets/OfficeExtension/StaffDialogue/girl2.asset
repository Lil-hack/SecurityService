  preparedVoicePath: Models/Piper/Mantella-RU-Piper-1.0/SKSE/Plugins/MantellaSoftware/piper/models/skyrim/low/femalecondescending.onnx
  preparedGreeting: "\u0416\u0430\u043D\u043D\u0430 \u041F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432\u043D\u0430. \u0423 \u043C\u0435\u043D\u044F \u0434\u0430\u0436\u0435 \u043A\u043E\u0448\u0435\u043B\u0451\u043A \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043B\u0443\u0448\u0430\u0435\u0442 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u044B, \u0430 \u043F\u043E\u0442\u043E\u043C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F. \u0427\u0435\u043C \u0443\u0434\u0438\u0432\u0438\u0448\u044C?"
  preparedPaid: "\u0422\u044B\u0441\u044F\u0447\u0443 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432 \u044F \u0443\u0436\u0435 \u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0430. \u041D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0439 \u043D\u0430\u0448\u0443 \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u0443\u044E \u0434\u0440\u0443\u0436\u0431\u0443 \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0437\u0430\u0433\u0430\u0434\u043A\u0443!"
