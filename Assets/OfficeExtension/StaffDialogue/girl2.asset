  id: girl2
  displayName: "\u0416\u0430\u043D\u043D\u0430 \u041F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432\u043D\u0430"
  difficulty: 4
  personality: "\u0423\u0432\u0435\u0440\u0435\u043D\u043D\u0430\u044F \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u0430\u044F \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u043D\u044F \u0441 \u043E\u0441\u0442\u0440\u044B\u043C \u044E\u043C\u043E\u0440\u043E\u043C. \u0415\u0451 \u043A\u043E\u0448\u0435\u043B\u0451\u043A, \u043F\u043E \u0441\u043B\u0443\u0445\u0430\u043C, \u043E\u043A\u043E\u043D\u0447\u0438\u043B \u0431\u0438\u0437\u043D\u0435\u0441-\u0448\u043A\u043E\u043B\u0443. \u041D\u0435 \u0442\u0435\u0440\u043F\u0438\u0442 \u043F\u043E\u0434\u043B\u0438\u0437\u044B\u0432\u0430\u043D\u0438\u044F \u0438 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u043D\u043E \u0443\u0432\u0430\u0436\u0430\u0435\u0442 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C, \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C \u0438 \u0443\u043C\u043D\u044B\u0435 \u0448\u0443\u0442\u043A\u0438."
  preferences: "\u041D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u043F\u043E\u0445\u0432\u0430\u043B\u0430 \u0435\u0451 \u043F\u0440\u043E\u043D\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438, \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438, \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443 \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u044E, \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0438\u043B\u0438 \u0443\u043C\u0435\u043D\u0438\u044E \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0441\u043B\u043E\u0432\u043E. \u0414\u043B\u044F \u0437\u0430\u0439\u043C\u0430 \u0432\u0430\u0436\u043D\u044B \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0446\u0435\u043B\u044C, \u044F\u0441\u043D\u044B\u0439 \u0441\u0440\u043E\u043A \u0438 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u043B\u0430\u043D \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430. \u041A\u0430\u0436\u0434\u044B\u0439 \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0445\u043E\u0434 \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u0440\u0438\u0432\u043D\u043E\u0441\u0438\u0442\u044C \u043D\u043E\u0432\u043E\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E, \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0438\u043B\u0438 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442. \u0411\u0430\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u043B\u0435\u0441\u0442\u044C, \u0441\u0435\u043A\u0441\u0443\u0430\u043B\u044C\u043D\u044B\u0435 \u043D\u0430\u043C\u0451\u043A\u0438, \u0432\u044B\u0434\u0443\u043C\u0430\u043D\u043D\u043E\u0435 '\u0442\u044B \u043E\u0431\u044F\u0437\u0430\u043D\u0430', \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u044B \u043D\u0435 \u0443\u0431\u0435\u0436\u0434\u0430\u044E\u0442."
  greeting: "\u0416\u0430\u043D\u043D\u0430 \u041F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432\u043D\u0430. \u0423 \u043C\u0435\u043D\u044F \u0434\u0430\u0436\u0435 \u043A\u043E\u0448\u0435\u043B\u0451\u043A \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043B\u0443\u0448\u0430\u0435\u0442 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u044B, \u0430 \u043F\u043E\u0442\u043E\u043C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F. \u0427\u0435\u043C \u0443\u0434\u0438\u0432\u0438\u0448\u044C?"
  alreadyPaidGreeting: "\u0422\u044B\u0441\u044F\u0447\u0443 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432 \u044F \u0443\u0436\u0435 \u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0430. \u041D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0439 \u043D\u0430\u0448\u0443 \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u0443\u044E \u0434\u0440\u0443\u0436\u0431\u0443 \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0437\u0430\u0433\u0430\u0434\u043A\u0443!"
