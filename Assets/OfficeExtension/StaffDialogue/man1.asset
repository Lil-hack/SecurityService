  preparedVoicePath: Models/Piper/Mantella-RU-Piper-1.0/SKSE/Plugins/MantellaSoftware/piper/models/skyrim/low/maleyoungeager.onnx
  preparedGreeting: "\u041E, \u043A\u043E\u043B\u043B\u0435\u0433\u0430! \u042F \u0413\u0435\u043D\u0430 \u041F\u0435\u0440\u0435\u043A\u0443\u0440\u043E\u0432, \u0432\u043D\u0435\u0448\u0442\u0430\u0442\u043D\u044B\u0439 \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440 \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F. \u0427\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u043D\u0430 \u0434\u0443\u0448\u0435?"
  preparedPaid: "\u0421\u043E\u0442\u043D\u044E \u044F \u0442\u0435\u0431\u0435 \u0443\u0436\u0435 \u043E\u0434\u043E\u043B\u0436\u0438\u043B. \u0414\u0440\u0443\u0436\u0431\u0430 \u0434\u0440\u0443\u0436\u0431\u043E\u0439, \u0430 \u043A\u043E\u0448\u0435\u043B\u0451\u043A \u043F\u0440\u043E\u0441\u0438\u0442 \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0442\u044C \u043F\u0440\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0442!"
