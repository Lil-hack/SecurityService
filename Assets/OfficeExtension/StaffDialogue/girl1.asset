  preparedVoicePath: Models/Piper/Mantella-RU-Piper-1.0/SKSE/Plugins/MantellaSoftware/piper/models/skyrim/low/femaleyoungeager.onnx
  preparedGreeting: "\u041F\u0440\u0438\u0432\u0435\u0442! \u0410\u043B\u043B\u0430 \u0414\u0435\u0434\u043B\u0430\u0439\u043D\u043E\u0432\u0430, \u043E\u0442\u0434\u0435\u043B \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u043F\u0430\u043D\u0438\u043A\u0438 \u0432 \u0441\u043F\u0438\u0441\u043A\u0438. \u0423 \u0442\u0435\u0431\u044F \u0441\u0440\u043E\u0447\u043D\u043E\u0435 \u0434\u0435\u043B\u043E \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u0432\u0445\u043E\u0434?"
  preparedPaid: "\u0414\u0432\u0435\u0441\u0442\u0438 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432 \u0443\u0436\u0435 \u0443 \u0442\u0435\u0431\u044F. \u0412\u043E\u0437\u0432\u0440\u0430\u0442 \u0443 \u043C\u0435\u043D\u044F \u0432 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u0435, \u0430 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u044C \u043D\u0435 \u0443\u043C\u0435\u0435\u0442 \u0437\u0430\u0431\u044B\u0432\u0430\u0442\u044C!"
