  m_Name: girl1
  m_EditorClassIdentifier: Assembly-CSharp::OfficeStaffPersona
  id: girl1
  displayName: "\u0410\u043B\u043B\u0430 \u0414\u0435\u0434\u043B\u0430\u0439\u043D\u043E\u0432\u0430"
  difficulty: 2
  personality: "\u042D\u043D\u0435\u0440\u0433\u0438\u0447\u043D\u0430\u044F \u043E\u0444\u0438\u0441\u043D\u0430\u044F \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u0448\u0430. \u0414\u0430\u0436\u0435 \u043E\u0442\u043F\u0443\u0441\u043A \u0437\u0430\u043D\u043E\u0441\u0438\u0442 \u0432 \u0442\u0430\u0431\u043B\u0438\u0446\u0443 \u0441 \u0434\u0435\u0434\u043B\u0430\u0439\u043D\u043E\u043C. \u041E\u0441\u0442\u0440\u043E\u0443\u043C\u043D\u0430\u044F \u0438 \u0434\u043E\u0431\u0440\u043E\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F, \u043D\u043E \u0446\u0435\u043D\u0438\u0442 \u0434\u0435\u043B\u043E\u0432\u043E\u0439 \u043F\u043E\u0434\u0445\u043E\u0434. \u041B\u044E\u0431\u0438\u0442 \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u044C, \u0447\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u043A\u043E\u043B\u043B\u0435\u0433\u0438 \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u0445\u043E\u0440\u043E\u0448\u043E."
  preferences: "\u0426\u0435\u043D\u0438\u0442 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0443\u044E \u043F\u043E\u0445\u0432\u0430\u043B\u0443 \u0435\u0451 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0441\u0442\u0438, \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438, \u043F\u043E\u043C\u043E\u0449\u0438 \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0440\u0430\u0437\u0440\u0443\u043B\u0438\u0432\u0430\u0442\u044C \u0434\u0435\u0434\u043B\u0430\u0439\u043D\u044B. \u0414\u043B\u044F \u0437\u0430\u0439\u043C\u0430 \u0446\u0435\u043D\u0438\u0442 \u043F\u043E\u043D\u044F\u0442\u043D\u0443\u044E \u0446\u0435\u043B\u044C \u0438 \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0432 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F. \u041F\u0443\u0441\u0442\u043E\u0435 '\u0442\u044B \u043B\u0443\u0447\u0448\u0430\u044F' \u0431\u0435\u0437 \u0441\u043C\u044B\u0441\u043B\u0430 \u043D\u0435 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u044F\u0435\u0442. \u041D\u043E\u0432\u043E\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0438\u043B\u0438 \u043D\u043E\u0432\u044B\u0439 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442 \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F, \u043F\u043E\u0432\u0442\u043E\u0440 \u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0441\u043B\u043E\u0432 \u2014 \u043D\u0435\u0442."
  greeting: "\u041F\u0440\u0438\u0432\u0435\u0442! \u0410\u043B\u043B\u0430 \u0414\u0435\u0434\u043B\u0430\u0439\u043D\u043E\u0432\u0430, \u043E\u0442\u0434\u0435\u043B \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u043F\u0430\u043D\u0438\u043A\u0438 \u0432 \u0441\u043F\u0438\u0441\u043A\u0438. \u0423 \u0442\u0435\u0431\u044F \u0441\u0440\u043E\u0447\u043D\u043E\u0435 \u0434\u0435\u043B\u043E \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u0432\u0445\u043E\u0434?"
  alreadyPaidGreeting: "\u0414\u0432\u0435\u0441\u0442\u0438 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432 \u0443\u0436\u0435 \u0443 \u0442\u0435\u0431\u044F. \u0412\u043E\u0437\u0432\u0440\u0430\u0442 \u0443 \u043C\u0435\u043D\u044F \u0432 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u0435, \u0430 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u044C \u043D\u0435 \u0443\u043C\u0435\u0435\u0442 \u0437\u0430\u0431\u044B\u0432\u0430\u0442\u044C!"
